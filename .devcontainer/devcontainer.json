{
  "name": "PLP — Paradigmas de Linguagens de Programação",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21" },
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash ferramentas/instalar-ambiente.sh --geradores",
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "vscjava.vscode-java-pack",
        "ms-dotnettools.csharp",
        "ms-python.python",
        "betterthantomorrow.calva",
        "arthurwang.vsc-prolog",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "files.encoding": "utf8",
        "markdown.preview.breaks": false
      }
    },
    "codespaces": {
      "openFiles": ["README.md", "codigo/README.md"]
    }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
